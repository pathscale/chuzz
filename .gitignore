/target
*.log
.DS_Store

# Frontend build output and dependencies. `dist` is generated by
# `rsbuild build` and served by the shell; committing it would put a hashed
# bundle in every diff.
node_modules/
apps/chuzz/dist/

# Handover notes are session state, tracked locally and never committed.
docs/HANDOVER-*.md

# Local-only renderer patch, see the file itself.
.cargo/config.toml
.cargo/config.toml.disabled

# Tauri generates capability schemas during Cargo builds.
apps/chuzz/gen/

# Engine redirect for local builds. Untracked on purpose: it names paths that
# exist on one machine. See scripts/local-engine.sh.
.cargo/local-engine.toml

# Python bytecode from scripts/corpus/
__pycache__/
*.pyc
