{
  "name": "chuzz-frontend",
  "version": "0.1.0",
  "description": "Chuzz \u2014 browser chrome frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "rsbuild dev",
    "start": "rsbuild dev",
    "build": "bun run typecheck && rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format . --write",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "@iconify/tailwind4": "^1.0.6",
    "@pathscale/ui": "^1.3.1",
    "@tauri-apps/api": "^2.1.1",
    "clsx": "^2.1.1",
    "popmotion": "^11.0.5",
    "solid-js": "^1.9.5",
    "tailwind-merge": "^3.6.0",
    "solid-layouts": "file:../../../../solid-layouts/packages/solid-layouts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@rsbuild/core": "^1.3.20",
    "@rsbuild/plugin-babel": "^1.0.5",
    "@rsbuild/plugin-solid": "^1.0.5",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^22.15.17",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
