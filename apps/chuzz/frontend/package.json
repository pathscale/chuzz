{
  "name": "chuzz-frontend",
  "version": "0.1.0",
  "description": "Chuzz browser interface frontend",
  "type": "module",
  "private": true,
  "workspaces": [
    "local-ui/bundle"
  ],
  "scripts": {
    "layouts:local": "solid-layouts-library --root local-ui && bun run scripts/solid-2-boundary.ts",
    "predev": "bun run layouts:local",
    "prestart": "bun run layouts:local",
    "prebuild": "bun run layouts:local",
    "pretypecheck": "bun run layouts:local",
    "pretest": "bun run layouts:local",
    "pretest:run": "bun run layouts:local",
    "dev": "rsbuild dev",
    "start": "rsbuild dev",
    "build": "tsc --noEmit && rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format . --write",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "@chuzz/ui": "workspace:*",
    "@iconify/tailwind4": "^1.0.6",
    "@pathscale/ui": "^2.11.10",
    "@solidjs/web": "2.0.0-rc.4",
    "@tauri-apps/api": "^2.1.1",
    "clsx": "^2.1.1",
    "popmotion": "^11.0.5",
    "solid-js": "2.0.0-rc.4",
    "solid-layouts": "^0.2.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/mdi": "^1.2.3",
    "@rsbuild/core": "^1.3.20",
    "@rsbuild/plugin-babel": "^1.0.5",
    "@rsbuild/plugin-solid": "^1.0.5",
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^22.15.17",
    "babel-preset-solid": "^2.0.0-rc.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "jsdom": "^30.0.0",
    "rsbuild-plugin-solid-layouts": "^0.2.1",
    "solid-layouts-oxc": "0.2.1",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.2",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "babel-preset-solid": "^2.0.0-rc.2"
  }
}
