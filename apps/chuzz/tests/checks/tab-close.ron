        subject: "#tab-close-marker-C",
        expect: Paints,
    ),
    (
        id: "tab-close-several-tabs",
        group: "tab-close",
        what: "the fixture has three distinct tabs before closing",
        subject: "tab:",
        expect: Count,
        expect_count: Some(3),
    ),
    (
        id: "tab-close-active-last",
        group: "tab-close",
        what: "coordinate close removes the active last tab in the strip",
        hover: Some("tab:tab-close-C"),
        click: Some("button:Close tab: tab-close-C"),
        subject: "button:Close tab: tab-close-C",
        expect: Vanishes,
    ),
    (
        id: "tab-close-active-last-count",
        group: "tab-close",
        what: "closing the active last tab leaves exactly two tabs",
        subject: "tab:",
        expect: Count,
        expect_count: Some(2),
    ),
    (
        id: "tab-close-active-last-survivor",
        group: "tab-close",
        what: "closing the active last tab selects its left neighbor",
        subject: "#tab-close-marker-B",
