[
    (
        id: "tab-close-load-a",
        group: "tab-close",
        what: "the A page loads into the existing tab through the address bar",
        type_into: Some("#chuzz-address-bar"),
        text: Some("https://127.0.0.1:49123/tab-close.html?tab=A"),
        key: Some("Enter"),
        subject: "tab:tab-close-A",
        expect: Present,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "tab-close-open-b",
        group: "tab-close",
        what: "a second tab opens from the new tab button",
        click: Some("#chuzz-new-tab"),
        subject: "tab:",
        expect: Grows,
    ),
    (
        id: "tab-close-load-b",
        group: "tab-close",
        what: "the B page loads into the second tab",
        type_into: Some("#chuzz-address-bar"),
        text: Some("https://127.0.0.1:49123/tab-close.html?tab=B"),
        key: Some("Enter"),
        subject: "tab:tab-close-B",
        expect: Present,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "tab-close-open-c",
        group: "tab-close",
        what: "a third tab opens for the multi-tab close cases",
        click: Some("#chuzz-new-tab"),
        subject: "tab:",
        expect: Grows,
    ),
    (
        id: "tab-close-load-c",
        group: "tab-close",
        what: "the C page loads into the third tab",
        type_into: Some("#chuzz-address-bar"),
        text: Some("https://127.0.0.1:49123/tab-close.html?tab=C"),
        key: Some("Enter"),
        subject: "tab:tab-close-C",
        expect: Present,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "tab-close-several-count",
        group: "tab-close",
        what: "the fixture has three labelled tabs before closing",
        subject: "tab:tab-close-",
        expect: Count,
        expect_count: Some(3),
    ),
    (
        id: "tab-close-active-last",
        group: "tab-close",
        what: "closing the active last tab removes it from the strip",
        hover: Some("tab:tab-close-C"),
        click: Some("button:Close tab: tab-close-C"),
        press: true,
        subject: "button:Close tab: tab-close-C",
        expect: Vanishes,
    ),
    (
        id: "tab-close-active-last-count",
        group: "tab-close",
        what: "closing the active last tab leaves exactly two labelled tabs",
        subject: "tab:tab-close-",
        expect: Count,
        expect_count: Some(2),
    ),
    (
        id: "tab-close-active-last-survivor",
        group: "tab-close",
        what: "with no right neighbour, the left neighbour B becomes active",
        subject: "#chuzz-address-bar",
        expect: ValueIs,
        expect_value: Some("https://127.0.0.1:49123/tab-close.html?tab=B"),
    ),
    (
        id: "tab-close-open-d",
        group: "tab-close",
        what: "a new tab opens at the end of the strip for the active middle case",
        click: Some("#chuzz-new-tab"),
        subject: "tab:",
        expect: Grows,
    ),
    (
        id: "tab-close-load-d",
        group: "tab-close",
        what: "the D page loads into the new tab",
        type_into: Some("#chuzz-address-bar"),
        text: Some("https://127.0.0.1:49123/tab-close.html?tab=D"),
        key: Some("Enter"),
        subject: "tab:tab-close-D",
        expect: Present,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "tab-close-select-b",
        group: "tab-close",
        what: "selecting B makes the middle tab active",
        click: Some("tab:tab-close-B"),
        subject: "tab:tab-close-B",
        expect: SelectionChanges,
    ),
    (
        id: "tab-close-active-middle",
        group: "tab-close",
        what: "closing the active middle tab selects the tab immediately to its right",
        hover: Some("tab:tab-close-B"),
        click: Some("button:Close tab: tab-close-B"),
        press: true,
        subject: "tab:tab-close-D",
        expect: SelectionChanges,
    ),
    (
        id: "tab-close-active-middle-count",
        group: "tab-close",
        what: "closing the active middle tab leaves exactly two labelled tabs",
        subject: "tab:tab-close-",
        expect: Count,
        expect_count: Some(2),
    ),
    (
        id: "tab-close-active-middle-survivor",
        group: "tab-close",
        what: "the right neighbour D is active after the middle tab closes",
        subject: "#chuzz-address-bar",
        expect: ValueIs,
        expect_value: Some("https://127.0.0.1:49123/tab-close.html?tab=D"),
    ),
    (
        id: "tab-close-inactive-first",
        group: "tab-close",
        what: "closing the inactive first tab removes only that tab",
        hover: Some("tab:tab-close-A"),
        click: Some("button:Close tab: tab-close-A"),
        press: true,
        subject: "button:Close tab: tab-close-A",
        expect: Vanishes,
    ),
    (
        id: "tab-close-inactive-first-count",
        group: "tab-close",
        what: "closing the inactive first tab leaves exactly one labelled tab",
        subject: "tab:tab-close-",
        expect: Count,
        expect_count: Some(1),
    ),
    (
        id: "tab-close-inactive-first-survivor",
        group: "tab-close",
        what: "the active D page stays active after an inactive close",
        subject: "#chuzz-address-bar",
        expect: ValueIs,
        expect_value: Some("https://127.0.0.1:49123/tab-close.html?tab=D"),
    ),
    (
        id: "tab-close-open-e",
        group: "tab-close",
        what: "a second tab opens for the active first case",
        click: Some("#chuzz-new-tab"),
        subject: "tab:",
        expect: Grows,
    ),
    (
        id: "tab-close-load-e",
        group: "tab-close",
        what: "the E page loads into the second tab",
        type_into: Some("#chuzz-address-bar"),
        text: Some("https://127.0.0.1:49123/tab-close.html?tab=E"),
        key: Some("Enter"),
        subject: "tab:tab-close-E",
        expect: Present,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "tab-close-select-d",
        group: "tab-close",
        what: "selecting D makes the first tab active",
        click: Some("tab:tab-close-D"),
        subject: "tab:tab-close-D",
        expect: SelectionChanges,
    ),
    (
        id: "tab-close-active-first",
        group: "tab-close",
        what: "closing the active first tab selects the tab immediately to its right",
        hover: Some("tab:tab-close-D"),
        click: Some("button:Close tab: tab-close-D"),
        press: true,
        subject: "tab:tab-close-E",
        expect: SelectionChanges,
    ),
    (
        id: "tab-close-active-first-count",
        group: "tab-close",
        what: "closing the active first tab leaves exactly one labelled tab",
        subject: "tab:tab-close-",
        expect: Count,
        expect_count: Some(1),
    ),
    (
        id: "tab-close-active-first-survivor",
        group: "tab-close",
        what: "the right neighbour E is active after the first tab closes",
        subject: "#chuzz-address-bar",
        expect: ValueIs,
        expect_value: Some("https://127.0.0.1:49123/tab-close.html?tab=E"),
    ),
    (
        id: "tab-close-open-f",
        group: "tab-close",
        what: "a second tab opens for the keyboard shortcut case",
        click: Some("#chuzz-new-tab"),
        subject: "tab:",
        expect: Grows,
    ),
    (
        id: "tab-close-load-f",
        group: "tab-close",
        what: "the F page loads into the active tab",
        type_into: Some("#chuzz-address-bar"),
        text: Some("https://127.0.0.1:49123/tab-close.html?tab=F"),
        key: Some("Enter"),
        subject: "tab:tab-close-F",
        expect: Present,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "tab-close-meta-w",
        group: "tab-close",
        what: "Meta+W closes the active tab, not the window",
        key: Some("Meta+w"),
        key_on: Some("#chuzz-address-bar"),
        subject: "button:Close tab: tab-close-F",
        expect: Vanishes,
    ),
    (
        id: "tab-close-meta-w-count",
        group: "tab-close",
        what: "the shortcut leaves exactly one labelled tab",
        subject: "tab:tab-close-",
        expect: Count,
        expect_count: Some(1),
    ),
    (
        id: "tab-close-meta-w-survivor",
        group: "tab-close",
        what: "the window survives the shortcut and E is active again",
        subject: "#chuzz-address-bar",
        expect: ValueIs,
        expect_value: Some("https://127.0.0.1:49123/tab-close.html?tab=E"),
    ),
    (
        id: "tab-close-last-close-disabled",
        group: "tab-close",
        what: "the close control of the only remaining tab is disabled",
        hover: Some("tab:tab-close-E"),
        subject: "button:Close tab: tab-close-E",
        expect: Disabled,
    ),
]
