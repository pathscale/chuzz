[
    (
        id: "tab-close-fixture-a",
        group: "tab-close",
        what: "the A page paints in the existing tab before the close sequence",
        navigate: Some("http://127.0.0.1:49123/tab-close.html?tab=A"),
        arrival_subject: Some("#tab-close-marker-A"),
        open_timeout_ms: 3000,
        subject: "#tab-close-marker-A",
        expect: Paints,
    ),
    (
        id: "tab-close-open-b",
        group: "tab-close",
        what: "a second tab opens and becomes the active tab",
        click: Some("#chuzz-new-tab"),
        subject: "tab:",
        expect: Grows,
    ),
    (
        id: "tab-close-fixture-b",
        group: "tab-close",
        what: "the B page paints in the second tab",
