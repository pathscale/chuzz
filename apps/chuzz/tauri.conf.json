{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chuzz",
  "identifier": "com.pathscale.chuzz",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:3013",
    "beforeDevCommand": "bun run dev -- --port 3013",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Chuzz",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#090d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["dist/icon-512.png", "icons/icon.icns"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
