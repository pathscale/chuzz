[
    (
        id: "tls-https-wss",
        group: "tls",
        what: "HTTPS assets and real TLS 1.2 and TLS 1.3 backend WSS sessions preserve bytes and answer six sequenced heartbeats",
        open: None,
        hover: None,
        click: Some("#run"),
        subject: "READY: TLS HTTPS WSS PASS",
        expect: PaintsNamed,
        covers: [
            "READY: HTTPS assets PASS",
            "READY: TLS1.3 WSS heartbeat PASS",
            "READY: TLS1.2 WSS heartbeat PASS",
            "READY: TLS HTTPS WSS PASS",
        ],
        outcome_timeout_ms: 60000,
    ),
]

