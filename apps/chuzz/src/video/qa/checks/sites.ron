[
    (
        id: "sites-consent",
        group: "sites",
        what: "a delegated consent click reaches the button and reads its cookie immediately",
        open: None,
        hover: None,
        click: Some("#accept"),
        subject: "READY: consent click cookie PASS",
        expect: PaintsNamed,
        covers: ["READY: consent click cookie PASS"],
        outcome_timeout_ms: 5000,
    ),
    (
        id: "sites-network",
        group: "sites",
        what: "real HTTP requests preserve headers, cookies, status, events and synchronous responses",
        open: None,
        hover: None,
        click: Some("#run-network"),
        subject: "READY: XHR headers status events sync abort PASS",
        expect: PaintsNamed,
        covers: ["READY: XHR headers status events sync abort PASS"],
        outcome_timeout_ms: 30000,
    ),
    (
        id: "sites-window-progress",
        group: "sites",
        what: "delayed fetch, worker delivery and GPU presentation finish without a page polling timer",
        open: None,
        hover: None,
        click: Some("#run-window"),
        subject: "READY: idle fetch worker GPU presentation PASS",
        expect: PaintsNamed,
        covers: ["READY: idle fetch worker GPU presentation PASS"],
        outcome_timeout_ms: 30000,
    ),
]
