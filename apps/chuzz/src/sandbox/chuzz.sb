; Adapted from WebKit Source/WebKit/WebProcess/com.apple.WebProcess.sb.in.
; Includes the Darwin runtime rules from WebKit's compiled macOS profile.
; Browser/broker are one process. L1 owns per-document network policy.
(version 1)
(deny default)
(deny nvram* system-privilege)
@PROCESS@
(allow network*)
(allow mach-bootstrap)
(allow syscall-mach)
(allow mach-kernel-endpoint)
(allow system-audit)
(allow process-info-pidinfo process-info-rusage process-codesigning-status* (target self))
(allow signal (target self))
(allow sysctl-read
    (sysctl-name "hw.memsize" "hw.ncpu" "hw.activecpu" "hw.logicalcpu" "hw.physicalcpu" "hw.pagesize" "kern.osrelease" "kern.osversion" "kern.boottime" "kern.osproductversion" "kern.ostype" "kern.maxfilesperproc" "hw.cputype" "hw.cpusubtype" "hw.machine" "sysctl.name2oid")
    (sysctl-name-prefix "hw.optional." "hw.perflevel" "net.routetable"))
; Metadata does not permit file contents or directory enumeration.
(allow file-read-metadata)
(allow file-read*
    (subpath "/System/Library" "/System/Cryptexes/OS" "/System/Volumes/Preboot/Cryptexes/OS" "/usr/lib" "/usr/share" "/private/var/db/timezone" "/Library/Fonts" "/Library/Apple/System")
    (literal "/dev/null" "/dev/zero" "/dev/random" "/dev/urandom")
    (literal @SHELL@))
(allow file-write-data (literal "/dev/null"))
(allow file-map-executable
    (subpath "/System/Library" "/System/Cryptexes/OS" "/System/Volumes/Preboot/Cryptexes/OS" "/usr/lib")
    (literal @SHELL@))
(allow file-read* file-write* (subpath @CACHE@))
@READS@
(allow mach-lookup
    (global-name "com.apple.CARenderServer" "com.apple.WindowServer" "com.apple.windowserver.active" "com.apple.FontObjectsServer" "com.apple.fonts" "com.apple.SecurityServer" "com.apple.trustd" "com.apple.trustd.agent" "com.apple.system.opendirectoryd.libinfo" "com.apple.SystemConfiguration.configd" "com.apple.cfprefsd.daemon" "com.apple.cfprefsd.agent" "com.apple.system.notification_center" "com.apple.notifyd" "com.apple.MTLCompilerService"))
(allow mach-register (local-name "com.apple.axserver" "com.apple.tsm.portname"))
(allow ipc-posix-shm-read* ipc-posix-shm-write-data (ipc-posix-name-prefix "com.apple.WindowServer"))
(allow ipc-posix-shm-read* (ipc-posix-name "apple.shm.notification_center"))
(allow iokit-open-user-client (iokit-user-client-class "IOSurfaceRootUserClient" "AGXDeviceUserClient" "IOAccelerator"))
(allow iokit-open-service (iokit-user-client-class "IOSurfaceRoot") (iokit-registry-entry-class "IOAccelerator"))
(allow dynamic-code-generation)
