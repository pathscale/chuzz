[
    (
        id: "gpu-inspector-ready",
        group: "webgpu",
        what: "the labelled device and three-draw render loop start without validation errors",
        prepare: Some("#run"),
        prepare_unless: Some("READY: WebGPU inspector"),
        prepare_until: Some("READY: WebGPU inspector"),
        subject: "READY: WebGPU inspector",
        expect: PaintsNamed,
        open_timeout_ms: 30000,
        outcome_timeout_ms: 30000,
    ),
    (
        id: "gpu-inspector-pipeline",
        group: "webgpu",
        what: "the native pipeline registry follows a changed JS label",
        prepare: Some("#run"),
        prepare_unless: Some("READY: WebGPU inspector"),
        prepare_until: Some("READY: WebGPU inspector"),
        subject: "render-pipeline:inspector triangle",
        expect: GpuHasResource,
        open_timeout_ms: 30000,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "gpu-inspector-draws",
        group: "webgpu",
        what: "a sampled frame submits three draws into the named canvas",
        prepare: Some("#run"),
        prepare_unless: Some("READY: WebGPU inspector"),
        prepare_until: Some("READY: WebGPU inspector"),
        subject: "canvas:#stage",
        expect: GpuDraws(3),
        open_timeout_ms: 30000,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "gpu-inspector-no-errors",
        group: "webgpu",
        what: "no uncaptured or validation error has occurred before the deliberate error",
        prepare: Some("#run"),
        prepare_unless: Some("READY: WebGPU inspector"),
        prepare_until: Some("READY: WebGPU inspector"),
        subject: "gpu",
        expect: GpuNoErrors,
        open_timeout_ms: 30000,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "gpu-inspector-scoped-error",
        group: "webgpu",
        what: "the page swallows one scoped validation error and paints its own error count",
        prepare: Some("#run"),
        prepare_unless: Some("READY: WebGPU inspector"),
        prepare_until: Some("READY: WebGPU inspector"),
        click: Some("#error"),
        subject: "SCOPED ERRORS: 1",
        expect: PaintsNamed,
        open_timeout_ms: 30000,
        outcome_timeout_ms: 5000,
    ),
]

