// Run with ?break=nan. Only gpu-buffers-particles-range must fail.
[
    (
        id: "gpu-buffers-inspection",
        group: "webgpu",
        what: "GPU inspection is active before labeled buffers are created",
        open: None,
        hover: None,
        click: None,
        subject: "gpu",
        expect: GpuNoErrors,
        open_timeout_ms: 5000,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "gpu-buffers-ready",
        group: "webgpu",
        what: "the first GPU frame completes after inspection is enabled",
        open: None,
        hover: None,
        click: None,
        prepare: Some("#run"),
        prepare_unless: Some("READY: WebGPU buffers"),
        prepare_until: Some("READY: WebGPU buffers"),
        subject: "READY: WebGPU buffers",
        expect: PaintsNamed,
        open_timeout_ms: 30000,
        outcome_timeout_ms: 30000,
    ),
    (
        id: "gpu-buffers-no-errors",
        group: "webgpu",
        what: "the compute and indirect render passes raise no WebGPU errors",
        open: None,
        hover: None,
        click: None,
        prepare: Some("#run"),
        prepare_unless: Some("READY: WebGPU buffers"),
        prepare_until: Some("READY: WebGPU buffers"),
        subject: "gpu",
        expect: GpuNoErrors,
        open_timeout_ms: 30000,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "gpu-buffers-counter",
        group: "webgpu",
        what: "a dispatched compute pass increments the atomic u32 counter",
        open: None,
        hover: None,
        click: None,
        prepare: Some("#run"),
        prepare_unless: Some("READY: WebGPU buffers"),
        prepare_until: Some("READY: WebGPU buffers"),
        subject: "buffer:qa-counter",
        expect: GpuBufferAtLeast(offset: 0, as: u32, value: 1.0),
        open_timeout_ms: 30000,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "gpu-buffers-indirect-vertices",
        group: "webgpu",
        what: "the compute pass writes vertexCount 3 at indirect byte offset 0",
        open: None,
        hover: None,
        click: None,
        prepare: Some("#run"),
        prepare_unless: Some("READY: WebGPU buffers"),
        prepare_until: Some("READY: WebGPU buffers"),
        subject: "buffer:qa-indirect",
        expect: GpuBufferEquals(offset: 0, as: u32, value: 3.0),
        open_timeout_ms: 30000,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "gpu-buffers-indirect-instances",
        group: "webgpu",
        what: "the compute pass writes at least one instance at indirect byte offset 4",
        open: None,
        hover: None,
        click: None,
        prepare: Some("#run"),
        prepare_unless: Some("READY: WebGPU buffers"),
        prepare_until: Some("READY: WebGPU buffers"),
        subject: "buffer:qa-indirect",
        expect: GpuBufferAtLeast(offset: 4, as: u32, value: 1.0),
        open_timeout_ms: 30000,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "gpu-buffers-particles-range",
        group: "webgpu",
        what: "all 256 particle components are finite and within [-1,1]",
        open: None,
        hover: None,
        click: None,
        prepare: Some("#run"),
        prepare_unless: Some("READY: WebGPU buffers"),
        prepare_until: Some("READY: WebGPU buffers"),
        subject: "buffer:qa-particles",
        expect: GpuBufferRange(offset: 0, length: 1024, as: f32, min: -1.0, max: 1.0, allow_non_finite: false),
        open_timeout_ms: 30000,
        outcome_timeout_ms: 5000,
    ),
]
