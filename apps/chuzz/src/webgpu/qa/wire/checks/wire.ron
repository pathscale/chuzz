[
    (
        id: "webgpu-wire-60-frames",
        group: "webgpu",
        what: "60 frames of 2000 recorded draws and 64 KiB uploads finish in under 6000 ms",
        open: None,
        hover: None,
        click: Some("#run"),
        subject: "READY: WEBGPUWIRE PASS",
        expect: PaintsNamed,
        covers: ["READY: WEBGPUWIRE PASS"],
        outcome_timeout_ms: 30000,
    ),
    (
        id: "webgpu-wire-validation-scope",
        group: "webgpu",
        what: "the invalid recorded draw is captured by the inner validation scope and its message is visible",
        open: None,
        hover: None,
        click: None,
        subject: "VALIDATION: WEBGPUWIRE CAPTURED",
        expect: PaintsNamed,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "webgpu-wire-canvas-paints",
        group: "webgpu",
        what: "the triangle using the snapshotted 64 KiB upload reaches the visible canvas",
        open: None,
        hover: None,
        click: None,
        subject: "#stage",
        expect: VisibleInk,
        outcome_timeout_ms: 5000,
    ),
]
