[
    (
        id: "canvassrc-native-sources",
        group: "canvas2d",
        what: "six completed frames draw a 1024-square canvas 200 times and a decoded image 200 times, preserving source versions, patterns, self-draw and mutable ImageData",
        open: None,
        hover: None,
        click: Some("#run"),
        subject: "PASS: CANVASSRC native sources",
        expect: PaintsNamed,
        covers: ["Budget: 750 ms per completed frame", "Pixel buffers transferred: 0"],
        outcome_timeout_ms: 30000,
    ),
    (
        id: "canvassrc-target-paints",
        group: "canvas2d",
        what: "the pixel-checked canvas and decoded image samples reach document painting",
        open: None,
        hover: None,
        click: None,
        subject: "#target",
        expect: VisibleInk,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "canvassrc-self-paints",
        group: "canvas2d",
        what: "the overlapping self-draw colour samples reach document painting",
        open: None,
        hover: None,
        click: None,
        subject: "#self",
        expect: VisibleInk,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "canvassrc-patterns-paint",
        group: "canvas2d",
        what: "the source-write and resize pattern samples reach document painting",
        open: None,
        hover: None,
        click: None,
        subject: "#patterns",
        expect: VisibleInk,
        outcome_timeout_ms: 5000,
    ),
]

