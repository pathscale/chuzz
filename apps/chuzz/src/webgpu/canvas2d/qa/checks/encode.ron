[
    (
        id: "canvas-encode-roundtrip",
        group: "canvas-encode",
        what: "toBlob and toDataURL produce PNGs that decode back to the drawn red, green and translucent blue pixels",
        open: None,
        hover: None,
        click: Some("#run"),
        subject: "READY: canvas encode PASS",
        expect: PaintsNamed,
        outcome_timeout_ms: 15000,
    ),
    (
        id: "canvas-encode-blob-paints",
        group: "canvas-encode",
        what: "the image decoded from the toBlob PNG reaches document painting",
        open: None,
        hover: None,
        click: None,
        subject: "#from-blob",
        expect: VisibleInk,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "canvas-encode-data-paints",
        group: "canvas-encode",
        what: "the image decoded from the toDataURL PNG reaches document painting",
        open: None,
        hover: None,
        click: None,
        subject: "#from-data",
        expect: VisibleInk,
        outcome_timeout_ms: 5000,
    ),
]
