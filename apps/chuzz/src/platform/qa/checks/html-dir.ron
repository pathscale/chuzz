[
    (
        id: "html-dir-behaviour",
        group: "html-dir",
        what: "HTMLElement.prototype owns dir and the instance reflects the direction attribute.",
        open: None,
        hover: None,
        click: Some("#run"),
        subject: "READY: HTML-DIR PASS",
