[
    (
        id: "svggeom-hull-link",
        group: "svggeom",
        what: "SVG href anchor has a non-zero painted client box and link semantics",
        open: None,
        hover: None,
        click: None,
        subject: "link:Hull panel",
        expect: Paints,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "svggeom-engine-link",
        group: "svggeom",
        what: "SVG xlink:href anchor exposes its child's visible ink",
        open: None,
        hover: None,
        click: None,
        subject: "link:Engine panel",
        expect: VisibleInk,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "svggeom-geometry",
        group: "svggeom",
        what: "scaled viewBox and group transforms, client fragments, basic getBBox, mutation, resize, scrolling, CSS transforms, insertion and removal, and preserveAspectRatio alignment",
        open: None,
        hover: None,
        click: Some("#run"),
        subject: "SVGGEOM GEOMETRY PASS",
        expect: PaintsNamed,
        covers: ["SVGGEOM GEOMETRY PASS"],
        outcome_timeout_ms: 10000,
    ),
    (
        id: "svggeom-hull-click",
        group: "svggeom",
        what: "click reaches an SVG href anchor and its cancelled default action does not navigate",
        open: None,
        hover: None,
        click: Some("link:Hull panel"),
        subject: "SVGGEOM HULL CLICK PASS",
        expect: PaintsNamed,
        covers: ["SVGGEOM HULL CLICK PASS"],
        outcome_timeout_ms: 5000,
    ),
    (
        id: "svggeom-engine-click",
        group: "svggeom",
        what: "click reaches an SVG xlink:href anchor and can cancel navigation",
        open: None,
        hover: None,
        click: Some("link:Engine panel"),
        subject: "SVGGEOM ENGINE CLICK PASS",
        expect: PaintsNamed,
        covers: ["SVGGEOM ENGINE CLICK PASS"],
        outcome_timeout_ms: 5000,
    ),
    (
        id: "svggeom-circle-click",
        group: "svggeom",
        what: "circle listener receives the click through a pointer-events:none overlay",
        open: None,
        hover: None,
        click: Some("#orb"),
        subject: "SVGGEOM CIRCLE CLICK PASS",
        expect: PaintsNamed,
        covers: ["SVGGEOM CIRCLE CLICK PASS"],
        outcome_timeout_ms: 5000,
    ),
    (
        id: "svggeom-hover",
        group: "svggeom",
        what: "SVG anchor ancestry receives mouseenter and its hover selector matches",
        open: None,
        hover: Some("link:Hull panel"),
        click: None,
        subject: "SVGGEOM HOVER PASS",
        expect: PaintsNamed,
        covers: ["SVGGEOM HOVER PASS"],
        outcome_timeout_ms: 5000,
    ),
]

