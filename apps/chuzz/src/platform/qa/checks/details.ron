[
    (
        id: "details-summary-click-opens",
        group: "details",
        what: "clicking the summary opens its details and paints the body that was hidden",
        open: None,
        hover: None,
        click: Some("#plates-toggle"),
        subject: "Apply plates",
        expect: PaintsNamed,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "details-toggle-event",
        group: "details",
        what: "the click queued one toggle event with closed>open, seen after open became true",
        open: None,
        hover: None,
        click: None,
        subject: "Toggles toggle:closed>open:true",
        expect: PaintsNamed,
        outcome_timeout_ms: 5000,
    ),
    (
        id: "details-scripted",
        group: "details",
        what: "open reflects, toggles coalesce per task and do not bubble, links and prevented clicks inside a summary do not toggle",
        open: None,
        hover: None,
        click: Some("#run"),
        subject: "READY: DETAILS PASS",
        expect: PaintsNamed,
        outcome_timeout_ms: 10000,
    ),
]
