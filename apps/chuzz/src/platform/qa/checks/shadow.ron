[
    (
        id: "sites-shadow",
        group: "shadow",
        what: "native roots, scoped styles, slots, constructable sheets and composed event boundaries work, including late parsed upgrades and moved named slots",
        open: None,
        hover: None,
        click: Some("#run"),
        subject: "PASS: shadow",
        expect: PaintsNamed,
        covers: ["Shadow button", "Slotted label", "Parsed logo", "Parsed search", "Parsed masthead icons"],
        outcome_timeout_ms: 10000,
    ),
    (
        id: "sites-shadow-interaction",
        group: "shadow",
        what: "a styled shadow button accepts a real pointer click",
        open: None,
        hover: None,
        click: Some("Shadow button"),
        subject: "PASS: shadow button interaction",
        expect: PaintsNamed,
        outcome_timeout_ms: 10000,
    ),
    (
        id: "sites-shadow-cloned-masthead",
        group: "shadow",
        what: "imported nested roots style and lay out cloned SVG icons, a named search input and conditional Sign in content; icon references use each shadow root's definitions",
        open: None,
        hover: None,
        click: Some("#run-masthead2"),
        subject: "PASS: cloned masthead",
        expect: PaintsNamed,
        covers: ["Cloned masthead logo", "Cloned masthead hamburger", "Cloned masthead search", "Cloned masthead Sign in"],
        outcome_timeout_ms: 10000,
    ),
]

