# Template for the Homebrew cask in pathscale/homebrew-tap.
#
# `@VERSION@` and `@SHA256@` are filled in by .github/workflows/release.yml,
# which then commits the result to the tap. The template is committed here so
# the cask is versioned alongside the app it installs rather than only in
# another repository.
cask "chuzz" do
  # Unlike AgencyZero's cask, this pins a real version and a real checksum
  # against a URL that carries the version. AgencyZero can point at a fixed
  # path with `sha256 :no_check` because it carries a self-updater and pulls
  # itself forward; Chuzz has none, so a fixed path would leave every installed
  # copy on whatever it first fetched, with `brew upgrade` unable to see that a
  # new release exists.
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://24x.ai/chuzz/Chuzz-#{version}.app.tar.gz"
  name "Chuzz"
  desc "Pure Rust web browser built on the Pathscale Blitz engine"
  homepage "https://github.com/pathscale/chuzz"

  # arm64 only, deliberately. An Intel Mac would install this happily and then
  # fail to launch, so refuse at install time where the message is legible.
  depends_on arch: :arm64
  depends_on macos: :big_sur

  app "Chuzz.app"

  # The bundle is ad-hoc signed, not notarized, so Gatekeeper rejects it and
  # Homebrew quarantines every cask artifact since 5.1 removed --no-quarantine.
  # Without this the app dies on first launch claiming to be damaged.
  #
  # Delete this block once the bundle is notarized: leaving it in would strip a
  # Gatekeeper check that users should get.
  postflight do
    system_command "/usr/bin/xattr",
                   args: ["-dr", "com.apple.quarantine", "#{appdir}/Chuzz.app"]
  end

  # Chuzz keeps no profile on disk yet: history and cookies live in memory for
  # the life of the process. These are the paths macOS creates on its own, plus
  # the control socket's descriptor directory.
  zap trash: [
    "~/Library/Caches/com.pathscale.chuzz",
    "~/Library/Saved Application State/com.pathscale.chuzz.savedState",
  ]
end
