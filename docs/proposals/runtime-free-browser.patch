-        let mut flags = NSEventModifierFlags::Command;
-        if shift {
-            flags |= NSEventModifierFlags::Shift;
-        }
-        let characters = NSString::from_str(&if shift {
-            key.to_ascii_uppercase()
-        } else {
-            key.to_owned()
