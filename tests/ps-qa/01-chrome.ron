[
    (
        id: "chrome-settings-opens",
        group: "chrome",
        what: "Settings opens the real Appearance dialog",
        open: None,
        hover: None,
        click: Some("#chuzz-settings"),
        subject: "dialog:Appearance",
        expect: PaintsNamed,
    ),
    (
        id: "chrome-settings-closes",
        group: "chrome",
        what: "the Appearance close control dismisses the dialog",
        open: None,
        hover: None,
        click: Some("#chuzz-settings-close"),
        subject: "dialog:Appearance",
        expect: Vanishes,
    ),
    (
        id: "chrome-inspector-opens",
        group: "chrome",
        what: "the inspector seam opens the visible inspector",
        open: None,
        hover: None,
        click: Some("#chuzz-inspector-toggle"),
        subject: "#chuzz-inspector-toggle",
        expect: NameChanges,
    ),
    (
        id: "chrome-inspector-closes",
        group: "chrome",
        what: "the inspector seam restores the full-width page",
        open: Some("Show inspector"),
        hover: None,
        click: Some("#chuzz-inspector-toggle"),
        subject: "#chuzz-inspector-toggle",
        expect: NameChanges,
    ),
    (
        id: "chrome-new-tab",
        group: "chrome",
        what: "New tab creates and selects a real tab",
        open: None,
        hover: None,
        click: Some("#chuzz-new-tab"),
        subject: "tab:",
        expect: Grows,
    ),
    (
        id: "chrome-close-new-tab",
        group: "chrome",
        what: "a repeated tab close control removes its own tab",
        open: None,
        hover: None,
        click: Some("#chuzz-tab-1-close"),
        subject: "#chuzz-tab-1",
        expect: Vanishes,
        covers: ["button:Close tab:"],
    ),
    (
        id: "chrome-address-navigates",
        group: "chrome",
        what: "typing an address and pressing Enter navigates the active tab",
        open: None,
        hover: None,
        click: None,
        type_into: Some("#chuzz-address-bar"),
        text: Some("http://127.0.0.1:49123/second.html"),
        key: Some("Enter"),
        key_on: None,
        subject: "#chuzz-tab-0",
        expect: NameChanges,
        outcome_timeout_ms: 3000,
    ),
    (
        id: "chrome-stress-navigation-stays-responsive",
        group: "chrome",
        what: "a module page with many completing images navigates without freezing browser chrome",
        open: None,
        hover: None,
        click: None,
        type_into: Some("#chuzz-address-bar"),
        text: Some("http://127.0.0.1:49123/stress.html"),
        key: Some("Enter"),
        key_on: None,
        subject: "#chuzz-tab-0",
        expect: NameChanges,
        outcome_timeout_ms: 3000,
    ),
    (
        id: "chrome-stress-recovery-navigates",
        group: "chrome",
        what: "browser chrome remains responsive enough to leave the redraw stress page",
        open: None,
        hover: None,
        click: None,
        type_into: Some("#chuzz-address-bar"),
        text: Some("http://127.0.0.1:49123/"),
        key: Some("Enter"),
        key_on: None,
        subject: "#chuzz-tab-0",
        expect: NameChanges,
        outcome_timeout_ms: 3000,
    ),
]
