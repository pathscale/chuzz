[
    (
        id: "theme-flower-distinct",
        group: "theme",
        what: "the 31 surface colours occupy distinct flower positions",
        open: Some("Settings"),
        hover: None,
        click: None,
        subject: "Surface colour *",
        expect: DistinctPositions,
    ),
    (
        id: "theme-surface-selects",
        group: "theme",
        what: "a surface flower option changes selectedness",
        open: Some("Settings"),
        hover: None,
        click: Some("option:Surface colour #601030"),
        subject: "option:Surface colour #601030",
        expect: SelectionChanges,
        covers: ["option:Surface colour "],
    ),
    (
        id: "theme-strength-selects",
        group: "theme",
        what: "colour strength applies and reports the chosen stop",
        open: Some("Settings"),
        hover: None,
        click: Some("#chuzz-theme-strength-4"),
        subject: "#chuzz-theme-strength-4",
        expect: SelectionChanges,
        covers: ["button:Colour strength "],
    ),
    (
        id: "theme-softness-selects",
        group: "theme",
        what: "softness applies and reports the chosen stop",
        open: Some("Settings"),
        hover: None,
        click: Some("#chuzz-theme-softness-2"),
        subject: "#chuzz-theme-softness-2",
        expect: SelectionChanges,
        covers: ["button:Softness "],
    ),
    (
        id: "theme-brightness-selects",
        group: "theme",
        what: "text brightness applies and reports the chosen stop",
        open: Some("Settings"),
        hover: None,
        click: Some("#chuzz-theme-brightness-4"),
        subject: "#chuzz-theme-brightness-4",
        expect: SelectionChanges,
        covers: ["button:Text brightness "],
    ),
    (
        id: "theme-accent-selects",
        group: "theme",
        what: "an accent option changes selectedness",
        open: Some("Settings"),
        hover: None,
        click: Some("#chuzz-theme-accent-3"),
        subject: "#chuzz-theme-accent-3",
        expect: SelectionChanges,
        covers: ["option:Designed yellow accent", "option:Accent colour "],
    ),
    (
        id: "theme-light-selects",
        group: "theme",
        what: "Light changes the complete interface mode",
        open: Some("Settings"),
        hover: None,
        click: Some("#chuzz-theme-light"),
        subject: "#chuzz-theme-light",
        expect: SelectionChanges,
    ),
    (
        id: "theme-dark-restores",
        group: "theme",
        what: "Dark restores the default interface mode",
        open: Some("Settings"),
        hover: None,
        click: Some("#chuzz-theme-dark"),
        subject: "#chuzz-theme-dark",
        expect: SelectionChanges,
    ),
    (
        id: "theme-reset",
        group: "theme",
        what: "Reset restores the authored theme and disables itself",
        open: Some("Settings"),
        hover: None,
        click: Some("#chuzz-theme-reset"),
        subject: "#chuzz-theme-reset",
        expect: Disabled,
    ),
]
