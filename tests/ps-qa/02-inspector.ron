[
    (
        id: "inspector-debugging-collapses",
        group: "inspector",
        what: "Debugging removes its painted body when collapsed",
        open: Some("Show inspector"),
        hover: None,
        click: Some("#collapsible-trigger-inspector-debugging"),
        subject: "#collapsible-content-inspector-debugging",
        expect: Vanishes,
    ),
    (
        id: "inspector-debugging-restores",
        group: "inspector",
        what: "Debugging restores its painted body",
        open: Some("Show inspector"),
        hover: None,
        click: Some("#collapsible-trigger-inspector-debugging"),
        subject: "#collapsible-content-inspector-debugging",
        expect: PaintsNamed,
    ),
    (
        id: "inspector-page-collapses",
        group: "inspector",
        what: "Page removes its painted body when collapsed",
        open: Some("Show inspector"),
        hover: None,
        click: Some("#collapsible-trigger-inspector-page"),
        subject: "#collapsible-content-inspector-page",
        expect: Vanishes,
    ),
    (
        id: "inspector-page-restores",
        group: "inspector",
        what: "Page restores its painted body",
        open: Some("Show inspector"),
        hover: None,
        click: Some("#collapsible-trigger-inspector-page"),
        subject: "#collapsible-content-inspector-page",
        expect: PaintsNamed,
        covers: ["button:Debugging", "button:Page", "button:History", "button:Network", "button:Console"],
    ),
]
